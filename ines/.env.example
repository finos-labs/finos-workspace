# ── LLM providers ──────────────────────────────────────────────
# Set the key of the provider that DEFAULT_MODEL names (or use Ollama below).
# A blank key leaves that provider out, and a model that names it then fails.
OPENAI_API_KEY=
OPENROUTER_API_KEY=          # Claude, Gemini, DeepSeek, etc. via OpenRouter
GROQ_API_KEY=
NVIDIA_API_KEY=              # NVIDIA NIM via integrate.api.nvidia.com

# Local models via Ollama.
# IN DOCKER: use host.docker.internal, NOT localhost — inside a container
# "localhost" is the container itself, so it can't reach Ollama on your host.
OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api   # when running in Docker

# ── Model selection ────────────────────────────────────────────
# No model is built into the agent: DEFAULT_MODEL is required and has no default.
# Write it "<provider>:<model>", where <model> is whatever that provider calls it.
# Effective model =  Workspace settings-wheel picker  >  DEFAULT_MODEL
# Every model call the agent makes (chat, titles, prompt enhancement, table
# extraction) uses it. Editing it needs a server RESTART (`--hot` reloads code,
# not .env).
DEFAULT_MODEL=
# More models that users may pick, comma-separated, written the same way. The agent offers
# DEFAULT_MODEL and these and refuses any other, so a user cannot spend the provider keys on a
# model the operator did not choose. Role grants in the Workspace's admin panel choose among them.
# INES_MODELS=

# ── Who can use the agent ──────────────────────────────────────
# By default every caller signs in with the Workspace API, which owns the users, their roles and
# their usage limits: the agent counts each question against the user's daily limit, refuses what
# their roles do not allow, and reports the tokens used. docker compose sets WORKSPACE_API_URL and
# INES_CORS_ORIGINS; `python -m scripts.create_local_env` in backend-api/backend fills in the two
# secrets below (the second is shared with the MCP server, which reads this file too).
#
# INES_AUTH=none runs without users and counts nothing: for a development machine only.
# INES_AUTH=workspace
# The Workspace API as the agent reaches it, not the address a browser uses.
# WORKSPACE_API_URL=
# The origin of the web app, comma-separated if there are several; * allows every origin.
# INES_CORS_ORIGINS=
# The token with which the agent reports usage: `python -m scripts.create_metering_token`.
# It runs out after a year (`--days` sets another span), and the API refuses one that never runs out:
# it lives in this file, so a token without an expiry could only be withdrawn by changing the API's
# JWT_SECRET, which signs out every user at the same time. Mint a new one before it expires; until you
# do, usage is not counted and the API answers 403 saying so.
INES_METERING_TOKEN=
# At least 16 characters. Signs the chat scope that the MCP tools receive.
INES_SCOPE_SECRET=
# How long a signed-in user is remembered, in seconds, before the API is asked again.
# INES_AUTH_CACHE_SECONDS=30
# Largest request accepted, in MB, and queries one user may have running at once.
# INES_MAX_BODY_MB=64
# INES_MAX_CONCURRENT_QUERIES=4
# Queries the whole agent runs at once (503 past it), requests one question may be made of, and the
# helper calls (titles, rewritten prompts) one user may make in a minute.
# INES_MAX_TOTAL_QUERIES=200
# INES_MAX_TURN_REQUESTS=60
# INES_HELPER_CALLS_PER_MINUTE=60
# Requests that are not questions (not JSON, wrong shape) one user may send in a minute; past it their questions are turned away unread.
# INES_INVALID_REQUESTS_PER_MINUTE=20
# A model with no native tool calling writes its calls into its text (<tool_call>{...}</tool_call>);
# the agent reads them as tool calls. "off" does not.
# INES_INLINE_TOOL_CALLS=on

# ── Running more than one of her ───────────────────────────────
# What Ines keeps between the requests of one turn — who is signed in, how much of a user's share is
# left, which turn is under way, and a chat's rows — lives in Redis when this names one, and in the
# process otherwise. Shared, every replica gives the same answer: a user has one share in all of them
# and a continuation is recognised wherever it lands. Without it, run one replica. docker compose sets
# it. The MCP server reads the same setting for the documents of a chat.
# REDIS_URL=redis://redis:6379

# ── MCP server: the tools the agent uses ───────────────────────
# Runs with the agent in docker compose, and every user has it. web_search and fetch_webpage need
# nothing (web_search uses DuckDuckGo and needs no key); the other tools are there when what they need is set.
DAYTONA_API_KEY=             # execute_code (Python sandbox)
# The sandbox can reach the network by default (it installs its packages when it starts). To cut it
# off, name a snapshot that already has the packages and set the network to blocked: code that a
# model was talked into writing by text in a page or a file then cannot send data anywhere.
# DAYTONA_SNAPSHOT=
# INES_SANDBOX_NETWORK=blocked
# fetch_webpage fetches only an address that was in the conversation (given by the user, or listed by a
# search, a page or a widget), so that text in a page cannot make the agent fetch an address with the
# user's data in it. "true" lets it fetch any address.
# INES_FETCH_ANY_URL=false
# Document search (query_documents) needs an embedding model, written <provider>:<model>
# like DEFAULT_MODEL, and that provider's key from above. The providers that embed are
# openai, openrouter, nvidia and ollama. There is no default.
INES_EMBED_MODEL=

# Workspace bridge (companion) MCP tools — 18 tools that drive a Workspace
# browser tab via /bridge/ws. Off by default; set "true" to enable.
COMPANION_TOOLS_ENABLED=false

# ── Logs and metrics ───────────────────────────────────────────
# Logs go to stdout. Every record is cleaned of secrets, session tokens, file bytes, signed file URLs and
# email addresses before it is written, and carries the request, user and chat it belongs to.
# LOG_LEVEL=info             # trace, debug, info, warning, error or fatal; debug when not in production
# LOG_FORMAT=json            # json or pretty; pretty when not in production
# Prometheus metrics, on a port of their own that is not published (0 turns them off).
# INES_METRICS_PORT=9464     # the agent
# MCP_METRICS_PORT=9465      # the MCP server
# Traces: set OTEL_EXPORTER_OTLP_ENDPOINT to export them (see the README).

# ── Debug ──────────────────────────────────────────────────────
# LIVE_DEBUG_TRACES=1   # clean live trace; 2 = full model I/O JSON (local only)
