# The Workspace backend that the add-in signs in to
VITE_BACKEND_URL=
# Where the add-in's documentation lives. Empty: the About and Reference pages say so.
VITE_HELP_URL=
# Where this add-in is served from. Excel loads the task pane from here.
VITE_ADDIN_BASE_URL=https://localhost:1420
VITE_ENV=DEVELOPMENT

# manifest.xml variables, filled in when the manifest is built
# A GUID that identifies the add-in to Office (generate one; do not reuse another add-in's)
ADDIN_UUID=
ADDIN_BASE_URL=https://localhost:1420
# The documentation address that the manifest points Office to
ADDIN_HELP_URL=
