{
  "name": "workspace-plugin-bq-ag-grid",
  "version": "1.1.0",
  "private": true,
  "description": "A Workspace widget plugin that shows any backend's rows in AG Grid Community",
  "author": "BrightQuery",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "demo-backend": "python3 examples/backend.py",
    "demo-hr-backend": "python3 examples/hr_backend.py"
  },
  "dependencies": {
    "ag-grid-community": "34.3.1",
    "ag-grid-react": "34.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
