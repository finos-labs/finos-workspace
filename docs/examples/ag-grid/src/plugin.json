{
  "manifestVersion": 1,
  "id": "ag-grid",
  "name": "AgGrid table",
  "description": "Renders the ag-grid widget type with AG Grid: OpenBB-style column definitions, render functions, hover cards, sparklines, ChartView, streaming row updates and grid events.",
  "publisher": {
    "name": "dlee-bq"
  },
  "icon": "assets/icon.svg",
  "host": {
    "api": 1,
    "afm": "0.11"
  },
  "adminSettings": {
    "schema": {
      "type": "object",
      "properties": {
        "licenseKey": {
          "type": "string",
          "title": "AgGrid license key",
          "description": "AgGrid Enterprise license key for every card of the organization. Leave it empty to run AgGrid Community.",
          "maxLength": 1024
        }
      }
    },
    "defaults": {
      "licenseKey": ""
    }
  },
  "entry": {
    "module": "entry.js",
    "styles": [
      "entry.css"
    ]
  },
  "contributes": {
    "widgets": [
      {
        "id": "grid",
        "name": "AgGrid table",
        "description": "A backend's tabular data as an AG Grid table, configured like OpenBB Workspace's table widget, with charts, sparklines and streaming.",
        "category": "Data",
        "handles": [
          {
            "type": "ag-grid",
            "response": {
              "accepts": "json",
              "description": "A grid as JSON: an ag-grid-ready object ({ columnDefs, rowData, gridOptions }) or pandas-style data (a list of records, a dict of columns, or {columns, index, data}). The endpoint gets theme=dark or theme=light."
            }
          }
        ],
        "permissions": [
          "core:data:read",
          "core:export:provide",
          "core:copilot:context",
          "core:clipboard:write",
          "core:download:save",
          "core:state:write",
          "core:ui:button",
          "core:ui:menu"
        ],
        "model": {
          "traits": {
            "data": {
              "bind": "data",
              "access": "read"
            },
            "config": {
              "bind": "config",
              "access": "read"
            },
            "theme": {
              "bind": "theme",
              "access": "read"
            },
            "adminSettings": {
              "bind": "adminSettings",
              "access": "read"
            },
            "state": {
              "bind": "state",
              "access": "readwrite"
            },
            "meta": {
              "bind": "meta",
              "access": "read"
            }
          }
        },
        "settings": {
          "schema": {
            "type": "object",
            "properties": {
              "licenseKey": {
                "type": "string",
                "title": "AgGrid license key",
                "description": "AgGrid Enterprise license key for this card. It replaces the organization's key.",
                "maxLength": 1024
              },
              "floatingFilters": {
                "type": "boolean",
                "title": "Floating filters",
                "description": "A filter box under each column header."
              }
            }
          },
          "defaults": {}
        },
        "grid": {
          "w": 24,
          "h": 16,
          "minW": 10,
          "minH": 6
        },
        "artifact": {
          "description": "A table of rows in AgGrid: sortable, filterable, groupable, selectable and exportable, with numbers right-aligned and formatted. Use it to show rows the user will want to work with, such as a list of records or the rows of a query.",
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rowData"
            ],
            "properties": {
              "columnDefs": {
                "type": "array",
                "maxItems": 60,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "headerName": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "type": {
                      "enum": [
                        "numericColumn",
                        "rightAligned"
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 40,
                      "maximum": 800
                    }
                  }
                }
              },
              "rowData": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ],
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "actions": [
          {
            "id": "floating-filters",
            "label": "Floating filters",
            "icon": "filter",
            "placement": "navbar",
            "toggles": "floatingFilters"
          },
          {
            "id": "autosize",
            "label": "Autosize columns",
            "icon": "assets/autosize.svg",
            "placement": "menu"
          },
          {
            "id": "clear-filters",
            "label": "Clear filters and sort",
            "icon": "refresh",
            "placement": "menu"
          }
        ]
      },
      {
        "id": "livegrid",
        "name": "AgGrid live grid",
        "description": "An ag-grid table kept current by a WebSocket that FINOS Workspace opens: snapshots, upserts and removals by row id.",
        "category": "Data",
        "handles": [
          {
            "type": "aggrid-livegrid",
            "response": {
              "accepts": "json",
              "description": "The columns and a first snapshot, { columnDefs, rowData, gridOptions }, every row with an id. The widget's data.streamEndpoint is a WebSocket whose JSON messages are {op: snapshot, rows}, {op: upsert, rows} and {op: remove, ids}."
            }
          }
        ],
        "permissions": [
          "core:data:read",
          "core:data:stream",
          "core:export:provide",
          "core:copilot:context",
          "core:clipboard:write",
          "core:download:save",
          "core:state:write"
        ],
        "model": {
          "traits": {
            "data": {
              "bind": "data",
              "access": "read"
            },
            "config": {
              "bind": "config",
              "access": "read"
            },
            "theme": {
              "bind": "theme",
              "access": "read"
            },
            "adminSettings": {
              "bind": "adminSettings",
              "access": "read"
            },
            "state": {
              "bind": "state",
              "access": "readwrite"
            },
            "meta": {
              "bind": "meta",
              "access": "read"
            }
          }
        },
        "settings": {
          "schema": {
            "type": "object",
            "properties": {
              "licenseKey": {
                "type": "string",
                "title": "AgGrid license key",
                "description": "AgGrid Enterprise license key for this card. It replaces the organization's key.",
                "maxLength": 1024
              }
            }
          },
          "defaults": {}
        },
        "grid": {
          "w": 24,
          "h": 16,
          "minW": 10,
          "minH": 6
        }
      },
      {
        "id": "ssrm",
        "name": "AgGrid server-side table",
        "description": "A large Postgres table paged, sorted, filtered, grouped and pivoted on the server.",
        "category": "Data",
        "handles": [
          {
            "type": "aggrid-ssrm",
            "definition": {
              "type": "object",
              "additionalProperties": false,
              "description": "OpenBB Workspace's table configuration (data.table there).",
              "properties": {
                "enableCharts": {
                  "type": "boolean"
                },
                "showAll": {
                  "type": "boolean"
                },
                "transpose": {
                  "type": "boolean"
                },
                "enableAdvanced": {
                  "type": "boolean"
                },
                "formatterFn": {
                  "type": "string",
                  "enum": [
                    "int",
                    "none",
                    "percent",
                    "normalized",
                    "normalizedPercent",
                    "dateToYear"
                  ]
                },
                "wsRowIdColumn": {
                  "type": "string",
                  "maxLength": 128
                },
                "chartView": {
                  "$ref": "#/$defs/chartView"
                },
                "columnsDefs": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "$ref": "#/$defs/column"
                  }
                }
              },
              "$defs": {
                "pointStyle": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fill": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "A hex colour or a CSS colour name."
                    },
                    "stroke": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "A hex colour or a CSS colour name."
                    },
                    "strokeWidth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "size": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 40
                    }
                  }
                },
                "sparklineOptions": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "stroke": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "A hex colour or a CSS colour name."
                    },
                    "strokeWidth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "fill": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "A hex colour or a CSS colour name."
                    },
                    "fillOpacity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "vertical",
                        "horizontal"
                      ]
                    },
                    "markers": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "size": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 40
                        },
                        "fill": {
                          "type": "string",
                          "maxLength": 64,
                          "description": "A hex colour or a CSS colour name."
                        },
                        "stroke": {
                          "type": "string",
                          "maxLength": 64,
                          "description": "A hex colour or a CSS colour name."
                        },
                        "strokeWidth": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 20
                        }
                      }
                    },
                    "pointsOfInterest": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "firstLast": {
                          "$ref": "#/$defs/pointStyle"
                        },
                        "minimum": {
                          "$ref": "#/$defs/pointStyle"
                        },
                        "maximum": {
                          "$ref": "#/$defs/pointStyle"
                        },
                        "highlighted": {
                          "$ref": "#/$defs/pointStyle"
                        },
                        "positiveNegative": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "positive": {
                              "$ref": "#/$defs/pointStyle"
                            },
                            "negative": {
                              "$ref": "#/$defs/pointStyle"
                            }
                          }
                        }
                      }
                    },
                    "customFormatter": {
                      "type": "string",
                      "maxLength": 2000,
                      "description": "An arrow function in a string, (params) => ({ fill, stroke, ... }). Evaluated without eval: literals, params.*, operators, ?: and Math functions."
                    },
                    "padding": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "top": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "right": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "bottom": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 50
                        },
                        "left": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 50
                        }
                      }
                    }
                  }
                },
                "sparkline": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "line",
                        "area",
                        "bar"
                      ]
                    },
                    "dataField": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "options": {
                      "$ref": "#/$defs/sparklineOptions"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "colorRule": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "condition": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "gt",
                        "lt",
                        "gte",
                        "lte",
                        "between",
                        "contains",
                        "notContains"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ],
                      "maxLength": 200
                    },
                    "range": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    },
                    "color": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "A hex colour or a CSS colour name."
                    },
                    "fill": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "condition",
                    "color"
                  ]
                },
                "renderFnParams": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "actionType": {
                      "type": "string",
                      "enum": [
                        "groupBy",
                        "sendToAgent",
                        "openUrl"
                      ]
                    },
                    "groupBy": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "paramName": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "valueField": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "forceUpdate": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "paramName"
                      ]
                    },
                    "sendToAgent": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "markdown": {
                          "type": "string",
                          "maxLength": 4000
                        },
                        "agentId": {
                          "type": "string",
                          "maxLength": 128
                        }
                      }
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2000,
                      "description": "openUrl: the link, with {field} placeholders. Without it, the cell's value is the link."
                    },
                    "colorValueKey": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "hoverCardData": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    },
                    "colorRules": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "$ref": "#/$defs/colorRule"
                      }
                    },
                    "hoverCard": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cellField": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "markdown": {
                          "type": "string",
                          "maxLength": 4000
                        }
                      }
                    }
                  }
                },
                "column": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "headerName": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "headerTooltip": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "chartDataType": {
                      "type": "string",
                      "enum": [
                        "category",
                        "series",
                        "time",
                        "excluded"
                      ]
                    },
                    "cellDataType": {
                      "type": "string",
                      "enum": [
                        "text",
                        "number",
                        "boolean",
                        "date",
                        "dateString",
                        "object"
                      ]
                    },
                    "align": {
                      "type": "string",
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    },
                    "enableCellChangeWs": {
                      "type": "boolean"
                    },
                    "formatterFn": {
                      "type": "string",
                      "enum": [
                        "int",
                        "none",
                        "percent",
                        "normalized",
                        "normalizedPercent",
                        "dateToYear"
                      ]
                    },
                    "decimalPlaces": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12
                    },
                    "renderFn": {
                      "type": [
                        "string",
                        "array"
                      ],
                      "maxLength": 32,
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "enum": [
                          "greenRed",
                          "titleCase",
                          "hoverCard",
                          "cellOnClick",
                          "columnColor",
                          "showCellChange"
                        ]
                      },
                      "description": "One of greenRed, titleCase, hoverCard, cellOnClick, columnColor, showCellChange, or a list of them."
                    },
                    "renderFnParams": {
                      "$ref": "#/$defs/renderFnParams"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 4000
                    },
                    "minWidth": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 4000
                    },
                    "maxWidth": {
                      "type": "number",
                      "minimum": 10,
                      "maximum": 4000
                    },
                    "hide": {
                      "type": "boolean"
                    },
                    "pinned": {
                      "type": "string",
                      "enum": [
                        "left",
                        "right"
                      ]
                    },
                    "prefix": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "suffix": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "sparkline": {
                      "$ref": "#/$defs/sparkline"
                    }
                  },
                  "required": [
                    "field"
                  ]
                },
                "chartView": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "chartType": {
                      "type": "string",
                      "enum": [
                        "column",
                        "groupedColumn",
                        "stackedColumn",
                        "normalizedColumn",
                        "bar",
                        "groupedBar",
                        "stackedBar",
                        "normalizedBar",
                        "line",
                        "scatter",
                        "bubble",
                        "pie",
                        "donut",
                        "doughnut",
                        "area",
                        "stackedArea",
                        "normalizedArea",
                        "histogram",
                        "radarLine",
                        "radarArea",
                        "nightingale",
                        "radialColumn",
                        "radialBar",
                        "sunburst",
                        "rangeBar",
                        "rangeArea",
                        "boxPlot",
                        "treemap",
                        "heatmap",
                        "waterfall",
                        "columnLineCombo",
                        "areaColumnCombo",
                        "customCombo"
                      ]
                    },
                    "cellRangeCols": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "type": "string",
                          "maxLength": 128
                        }
                      }
                    },
                    "ignoreCellRange": {
                      "type": "boolean"
                    },
                    "chartNavigatorEnabled": {
                      "type": "boolean"
                    },
                    "chartMiniChartEnabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        ],
        "permissions": [
          "core:data:read",
          "core:params:write",
          "core:export:provide",
          "core:copilot:context",
          "core:clipboard:write",
          "core:download:save",
          "core:state:write",
          "core:ui:notify",
          "core:ui:open-link"
        ],
        "model": {
          "traits": {
            "data": {
              "bind": "data",
              "access": "read"
            },
            "definition": {
              "bind": "definition",
              "access": "read"
            },
            "config": {
              "bind": "config",
              "access": "read"
            },
            "theme": {
              "bind": "theme",
              "access": "read"
            },
            "adminSettings": {
              "bind": "adminSettings",
              "access": "read"
            },
            "state": {
              "bind": "state",
              "access": "readwrite"
            },
            "meta": {
              "bind": "meta",
              "access": "read"
            }
          }
        },
        "settings": {
          "schema": {
            "type": "object",
            "properties": {
              "licenseKey": {
                "type": "string",
                "title": "AgGrid license key",
                "description": "AgGrid Enterprise license key for this card. It replaces the organization's key.",
                "maxLength": 1024
              }
            }
          },
          "defaults": {}
        },
        "grid": {
          "w": 24,
          "h": 18,
          "minW": 12,
          "minH": 8
        }
      },
      {
        "id": "sql",
        "name": "AgGrid SQL",
        "description": "Read-only SQL against the deployment's Postgres or its data files, with completion, and the result in AgGrid.",
        "category": "Data",
        "standalone": true,
        "handles": [
          {
            "type": "aggrid-sql",
            "definition": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "response": {
              "accepts": "json",
              "description": "Nothing the widget reads: the query runs in the plugin's backend."
            }
          }
        ],
        "permissions": [
          "core:data:read",
          "core:backend:call",
          "core:state:write",
          "core:export:provide",
          "core:copilot:context",
          "core:params:write",
          "core:ui:button",
          "core:dashboard:add-widget"
        ],
        "server": {
          "routes": [
            "postgres_schema",
            "postgres_query",
            "files_schema",
            "files_query"
          ]
        },
        "model": {
          "traits": {
            "state": {
              "bind": "state",
              "access": "readwrite"
            },
            "params": {
              "bind": "params",
              "access": "readwrite"
            },
            "capabilities": {
              "bind": "capabilities",
              "access": "read"
            }
          }
        },
        "settings": {
          "schema": {
            "type": "object",
            "properties": {
              "licenseKey": {
                "type": "string",
                "title": "AgGrid license key",
                "description": "AgGrid Enterprise license key for this card. It replaces the organization's key.",
                "maxLength": 1024
              }
            }
          },
          "defaults": {}
        },
        "grid": {
          "w": 24,
          "h": 18,
          "minW": 12,
          "minH": 8
        },
        "artifact": {
          "description": "Runs a read-only SQL query against the deployment's Postgres or data files, in the user's own session, and shows the result in AgGrid. Use it to answer a question about the deployment's data: write the query and set its source. The user can edit and rerun it.",
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sql"
            ],
            "properties": {
              "source": {
                "enum": [
                  "postgres",
                  "files"
                ]
              },
              "sql": {
                "type": "string",
                "maxLength": 8000
              }
            }
          }
        },
        "actions": [
          {
            "id": "freeze",
            "label": "Create static widget",
            "icon": "table",
            "placement": "navbar"
          }
        ]
      }
    ]
  }
}
