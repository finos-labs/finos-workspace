{
  "manifestVersion": 1,
  "id": "sql-explorer",
  "name": "SQL explorer",
  "description": "Read-only SQL through the plugin's own backend: against a Postgres the deployment runs, and with DuckDB over data files the deployment mounts.",
  "publisher": {
    "name": "dlee-bq"
  },
  "icon": "assets/icon.svg",
  "host": {
    "api": 1,
    "afm": "0.11"
  },
  "entry": {
    "module": "entry.js",
    "styles": [
      "entry.css"
    ]
  },
  "csp": {
    "script-src": [
      "'wasm-unsafe-eval'"
    ],
    "connect-src": [
      "blob:"
    ]
  },
  "cspNotes": {
    "script-src": "Compiles DuckDB-WASM, the package's own assets/duckdb-eh.wasm, which completes the editor's SQL inside the frame.",
    "connect-src": "DuckDB-WASM reads its binary from a blob: URL the frame makes of that asset. No host is reachable."
  },
  "secrets": [
    {
      "name": "postgres_url",
      "purpose": "The Postgres the explorer reads, as postgresql://<role>:<password>@<host>:<port>/<database>, for a role that may only read. Its host and port are the deployment's, added to the server network by a superuser as tcp://<host>:<port>."
    }
  ],
  "identity": "pseudonymous",
  "server": {
    "backend": {
      "protocol": 1,
      "routes": [
        {
          "id": "postgres_schema",
          "secrets": [
            "postgres_url"
          ],
          "response": {
            "maxBytes": 1048576,
            "timeoutMs": 15000
          }
        },
        {
          "id": "postgres_query",
          "args": {
            "sql": {
              "type": "string",
              "maxLength": 32768,
              "required": true
            }
          },
          "secrets": [
            "postgres_url"
          ],
          "response": {
            "maxBytes": 5242880,
            "timeoutMs": 30000
          }
        },
        {
          "id": "files_schema",
          "response": {
            "maxBytes": 1048576,
            "timeoutMs": 15000
          }
        },
        {
          "id": "files_query",
          "args": {
            "sql": {
              "type": "string",
              "maxLength": 32768,
              "required": true
            }
          },
          "response": {
            "maxBytes": 5242880,
            "timeoutMs": 30000
          }
        }
      ]
    }
  },
  "contributes": {
    "widgets": [
      {
        "id": "explorer",
        "name": "SQL explorer",
        "description": "Read-only SQL against the deployment's Postgres or its data files",
        "category": "Data",
        "standalone": true,
        "permissions": [
          "core:backend:call",
          "core:state:write",
          "core:export:provide",
          "core:copilot:context",
          "core:params:write"
        ],
        "server": {
          "routes": [
            "postgres_schema",
            "postgres_query",
            "files_schema",
            "files_query"
          ]
        },
        "grid": {
          "w": 24,
          "h": 16,
          "minW": 12,
          "minH": 8
        },
        "params": [
          {
            "paramName": "sql",
            "type": "text",
            "label": "SQL",
            "value": "SELECT region, sum(units) AS units FROM sales GROUP BY region ORDER BY region"
          }
        ]
      },
      {
        "id": "grid",
        "name": "SQL grid",
        "description": "Read-only SQL against the deployment's Postgres or its data files, with the result in AgGrid",
        "category": "Data",
        "standalone": true,
        "permissions": [
          "core:backend:call",
          "core:state:write",
          "core:export:provide",
          "core:copilot:context"
        ],
        "server": {
          "routes": [
            "postgres_schema",
            "postgres_query",
            "files_schema",
            "files_query"
          ]
        },
        "grid": {
          "w": 24,
          "h": 18,
          "minW": 12,
          "minH": 8
        }
      }
    ]
  }
}
