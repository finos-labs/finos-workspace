{
  "manifestVersion": 1,
  "id": "plotly-charts",
  "name": "Plotly charts",
  "description": "Renders the plotly widget type with plotly.js: any backend's Plotly figure, drawn as its author made it.",
  "publisher": { "name": "dlee-bq" },
  "icon": "assets/icon.svg",
  "host": { "api": 1, "afm": "0.11" },
  "entry": { "module": "entry.js", "styles": ["entry.css"] },
  "contributes": {
    "widgets": [
      {
        "id": "chart",
        "name": "Plotly chart",
        "description": "A backend's Plotly figure, drawn with plotly.js",
        "category": "Charts",
        "handles": [
          {
            "type": "plotly",
            "response": {
              "accepts": "json",
              "description": "A Plotly figure as JSON, {\"data\": [traces], \"layout\": {...}, \"frames\": [...]}, as plotly.py's fig.to_json() writes it. The endpoint gets theme=dark or theme=light."
            }
          }
        ],
        "artifact": {
          "description": "A chart drawn with Plotly from data you give it: bars, lines or points, or a pie. Use it for any chart of a few series over categories or over time.",
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["data"],
            "properties": {
              "data": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": { "enum": ["bar", "scatter", "pie"] },
                    "name": { "type": "string", "maxLength": 80 },
                    "mode": { "enum": ["lines", "markers", "lines+markers"] },
                    "orientation": { "enum": ["v", "h"] },
                    "x": { "type": "array", "maxItems": 500, "items": { "type": ["string", "number"], "maxLength": 80 } },
                    "y": { "type": "array", "maxItems": 500, "items": { "type": ["string", "number"], "maxLength": 80 } },
                    "labels": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 80 } },
                    "values": { "type": "array", "maxItems": 100, "items": { "type": "number" } }
                  }
                }
              },
              "layout": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string", "maxLength": 120 },
                  "barmode": { "enum": ["group", "stack"] },
                  "xaxis": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string", "maxLength": 80 } } },
                  "yaxis": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string", "maxLength": 80 } } }
                }
              }
            }
          }
        },
        "permissions": ["core:data:read", "core:export:provide", "core:copilot:context"],
        "grid": { "w": 20, "h": 12, "minW": 8, "minH": 6 }
      }
    ],
    "skills": [
      {
        "slug": "plotly-charts",
        "description": "How to show a chart with the Plotly charts component: which trace fits the question, the data it takes, and its limits.",
        "file": "skills/plotly-charts.md"
      }
    ]
  }
}
