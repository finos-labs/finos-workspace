upstream workspace_backend {
  server 127.0.0.1:8001;
}

# Resolve the Connection header for WebSocket upgrades. The Workspace MCP bridge
# (/app/workspace-mcp/bridge/ws) upgrades to a WebSocket; for normal requests
# $http_upgrade is empty and this maps to "close". Included files live inside the
# main nginx.conf http{} block, so this map sits at http context as required.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# The access log names each request's path without its query string, and the Referer the
# same way: a query can carry a credential (the signature of a pre-signed file URL, an OAuth
# code), and no log may keep one. Otherwise the lines read like nginx's "combined" format.
map $request_uri $request_path {
  "~^([^?]*)" $1;
}
map $http_referer $referer_path {
  ""           "-";
  "~^([^?#]*)" $1;
}
log_format workspace '$remote_addr - $remote_user [$time_local] '
                     '"$request_method $request_path $server_protocol" $status '
                     '$body_bytes_sent "$referer_path" "$http_user_agent"';

# The web app
server {
  listen ${PORT};
  server_name _;

  access_log /var/log/nginx/access.log workspace;

  root /usr/share/nginx/html;
  index index.html;

  # Catch-all SPA fallback for client-side routing.
  location / {
    try_files $uri $uri/ /index.html;
  }
}

# The API, on an origin of its own: the browser names the web app's origin in the Origin
# header of every call it makes to it, as the API requires of every request.
server {
  listen 8000;
  server_name _;

  access_log /var/log/nginx/access.log workspace;

  client_max_body_size 50m;

  location / {
    proxy_pass http://workspace_backend;
    proxy_http_version 1.1;
    # $http_host preserves the port (e.g. localhost:8000); $host strips it, which
    # breaks absolute URLs the backend builds from request.base_url (e.g. the
    # Workspace MCP bridge websocket_url).
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WebSocket upgrade for the Workspace MCP bridge; no-op for plain HTTP.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Don't buffer the MCP streamable-http (SSE) responses or the WS frames.
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }
}
