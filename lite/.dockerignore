# The build context is assembled from this directory + the backend/ and frontend/ source
# trees. Keep heavy / irrelevant directories out so the context stays small and Docker
# layer caching stays effective.

# Dependency / build artifacts pulled in when copying local checkouts.
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/dist
**/build
**/.next
**/coverage
**/.turbo
**/.vite

# VCS metadata — never needed in the image.
**/.git
**/.gitignore
**/.gitmodules

# Local env / editor noise, and the settings of a local stack (secrets and an administrator).
**/envs/.env
**/scripts/cfgs/*.toml
**/user_create.json
**/.env.local
**/.DS_Store
**/.idea
**/.vscode

# This repo's own tooling that the image doesn't need.
.github
build-local.sh
publish.sh
tests
README.md
README-ENDUSER.md
