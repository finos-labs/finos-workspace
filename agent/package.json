{
  "name": "agent",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:agent": "node --env-file-if-exists=.env --watch src/server.ts",
    "dev:mcp": "node --env-file-if-exists=.env --watch mcp-server/src/server.ts",
    "dev:all": "concurrently -n agent,mcp -c blue,green --kill-others 'npm run dev:agent' 'npm run dev:mcp'",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-module-mocks --import ./tests/setup.ts 'tests/**/*.test.ts' 'mcp-server/test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --import ./tests/setup.ts 'tests/**/*.test.ts' 'mcp-server/test/**/*.test.ts'",
    "evals": "node --env-file-if-exists=.env evals/runner.ts",
    "evals:widget": "node --env-file-if-exists=.env evals/runner.ts --group=widget-selection",
    "evals:intent": "node --env-file-if-exists=.env evals/runner.ts --group=intent",
    "evals:workspace": "node --env-file-if-exists=.env evals/runner.ts --group=workspace-context",
    "evals:routing": "node --env-file-if-exists=.env evals/runner.ts --group=tool-routing",
    "evals:sql": "node --env-file-if-exists=.env evals/runner.ts --group=sql-analysis",
    "evals:locale": "node --env-file-if-exists=.env evals/runner.ts --group=locale",
    "evals:skills": "node --env-file-if-exists=.env evals/runner.ts --group=skills",
    "smoke:rag": "node --env-file-if-exists=.env scripts/smoke-doc-rag.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.72",
    "@ai-sdk/openai": "^3.0.125",
    "@ai-sdk/provider": "^3.0.18",
    "@grpc/grpc-js": "^1.14.6",
    "@hono/mcp": "^0.2.5",
    "@hono/node-server": "^2.1.5",
    "@logtape/hono": "^2.4.0",
    "@logtape/logtape": "^2.4.0",
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "6.0.142",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.13.13",
    "ioredis": "5.10.1",
    "mammoth": "^1.13.0",
    "ollama-ai-provider-v2": "^3.6.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "concurrently": "9.2.1",
    "expect": "^30.5.2",
    "jest-mock": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "unzipper": "^0.12.5",
    "buffers": "npm:node-buffers@^0.1.1",
    "uuid": "^14.0.3",
    "@ai-sdk/provider-utils": "^4.0.63",
    "readdir-glob": {
      "minimatch": "^11.0.3"
    }
  }
}
