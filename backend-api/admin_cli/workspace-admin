def data_backend_add_cmd(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        endpoint_headers = None
        if args.headers:
            endpoint_headers = []
            for h in args.headers:
                parts = h.split(":", 2)
                if len(parts) < 2:
                    print(
                        f"✗ Invalid header format: {h}. "
                        "Use key:value or key:value:location",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                header: Dict[str, str] = {"key": parts[0], "value": parts[1]}
                if len(parts) == 3:
                    header["location"] = parts[2]
                endpoint_headers.append(header)

        resp = client.data_backend_add(
            args.entity_uuid, args.name, args.url, endpoint_headers
        )
        if args.json:
            print(json.dumps(resp, indent=2))
        else:
            print(
                f"✓ Data backend '{args.name}' added to entity {args.entity_uuid}"
            )
    except APIError as e:
        handle_api_error(e)


