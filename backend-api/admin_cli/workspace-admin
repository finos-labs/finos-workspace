def prompt_credentials(
    email: Optional[str], password: Optional[str]
) -> Tuple[str, str]:
    """The email and password, asking on the terminal for what was not given.

    Prompts go to stderr, so stdout carries only the command's output.
    """
    if not email:
        print("Email: ", end="", file=sys.stderr, flush=True)
        email = input()
    if not password:
        password = getpass.getpass("Password: ")
    return email, password


def end_session(client: HubAPIClient) -> None:
    """End a session this command opened for itself."""
    try:
        client.auth_logout()
    except APIError as e:
        print(
            f"! Could not end the session ({e}); it expires within 12 hours.",
            file=sys.stderr,
        )


def handle_api_error(error: APIError) -> NoReturn:
    print(f"✗ Error ({error.status_code}): {error.message}", file=sys.stderr)
    if error.status_code in ERROR_GUIDANCE:
        matched = False
        for key, guidance in ERROR_GUIDANCE[error.status_code].items():
            if key != "default" and key.lower() in error.message.lower():
                print(f"\n{guidance}", file=sys.stderr)
                matched = True
                break
        if not matched and "default" in ERROR_GUIDANCE[error.status_code]:
            print(f"\n{ERROR_GUIDANCE[error.status_code]['default']}", file=sys.stderr)
    sys.exit(1)


def get_client() -> HubAPIClient:
    """A signed-in client for this command.

    It uses WORKSPACE_ADMIN_TOKEN when set. Otherwise it signs in for this one
    command; the token stays in memory and the session ends when the command exits.
    """
    token = os.getenv(TOKEN_ENV)
    if token:
        return HubAPIClient(BASE_URL, token)
    if not sys.stdin.isatty():
        print(f"✗ Not signed in. Set {TOKEN_ENV}: {LOGIN_HINT}", file=sys.stderr)
        sys.exit(1)
    client = HubAPIClient(BASE_URL)
    email, password = prompt_credentials(None, None)
    try:
        client.access_token = client.auth_login(email, password)
    except APIError as e:
        handle_api_error(e)
    atexit.register(end_session, client)
    return client


def get_config_json(path: str) -> Dict[str, Any]:
    """Load JSON config from file path"""
    file_path = Path(path).resolve()
    if not file_path.exists():
        raise FileNotFoundError(f"File not found: {path}")
    return json.loads(file_path.read_text(encoding="utf-8", newline="\n"))


