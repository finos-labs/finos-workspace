def auth_login(args: argparse.Namespace) -> None:
    """Sign in and print the session as shell exports, for eval."""
    base_url = (args.api_url or BASE_URL).rstrip("/")
    email, password = prompt_credentials(args.email, args.password)
    try:
        token = HubAPIClient(base_url).auth_login(email, password)
    except APIError as e:
        handle_api_error(e)
    if args.json:
        print(json.dumps({"base_url": base_url, "access_token": token}, indent=2))
        return
    print(f"export {BASE_URL_ENV}={shlex.quote(base_url)}")
    print(f"export {TOKEN_ENV}={shlex.quote(token)}")
    if sys.stdout.isatty():
        print(
            "\nLoad the session straight into your shell instead of printing it:\n"
            f"  {LOGIN_HINT}",
            file=sys.stderr,
        )
    else:
        print("✓ Signed in for 12 hours", file=sys.stderr)


def auth_logout(args: argparse.Namespace) -> None:
    """End the session in WORKSPACE_ADMIN_TOKEN and print the unset, for eval."""
    token = os.getenv(TOKEN_ENV)
    if not token:
        print("✓ Not signed in", file=sys.stderr)
        return
    try:
        HubAPIClient(BASE_URL, token).auth_logout()
    except APIError as e:
        # 401: the session had already ended or expired
        if e.status_code != 401:
            handle_api_error(e)
    print(f"unset {TOKEN_ENV}")
    print("✓ Signed out", file=sys.stderr)


def auth_status(args: argparse.Namespace) -> None:
    status = {"base_url": BASE_URL, "token_set": bool(os.getenv(TOKEN_ENV))}
    fields = [
        ("Base URL", "base_url"),
        (f"{TOKEN_ENV} set", "token_set"),
    ]
    render_record(status, fields, args.json)


def entity_create(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        data = get_config_json(args.config)
        resp = client.entity_create(data)
        entity_uuid = resp.get("entity_uuid")
        if args.json:
            print(json.dumps(resp, indent=2))
        else:
            print(f"✓ Entity created: {entity_uuid}")
    except Exception as e:
        print(f"✗ Error: {e}", file=sys.stderr)
        sys.exit(1)


def entity_list(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        resp = client.entity_list(args.page, args.size)
        render_list(
            resp,
            args.json,
            lambda i: (
                f"{i['uuid']} | "
                f"{get_val(i, 'entity_type.code')} | "
                f"{i['name']} | "
                f"{get_val(i, 'entity_type.entity_type')} | "
                f"Sharing: {'on' if i.get('sharing_enabled') else 'off'}"
            ),
        )
    except APIError as e:
        handle_api_error(e)


