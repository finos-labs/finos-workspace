def provision_apply(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        p_cfg = get_config_json(args.config)

        # Transform config: merge admins and users into single users array with role
        users_list = []
        for admin in p_cfg.get("admins", []):
            users_list.append({**admin, "role": "admin"})
        for user in p_cfg.get("users", []):
            users_list.append({**user, "role": "user"})

        provision_config = {"entity": p_cfg["entity"], "users": users_list}

        # Use library method for orchestration
        if not args.json:
            print(f"Creating entity: {p_cfg['entity']['name']}...")

        lib_results = client.provision_full(provision_config)

        # Display progress (CLI responsibility)
        if not args.json:
            entity = lib_results["entity"]
            print(f"✓ Entity created: {entity['entity_uuid']}")

            for user in lib_results["users"]:
                role_label = "admin" if user.get("role") == "admin" else "member"
                print(f"✓ Creating {role_label}: {user['email']}")

            for failed in lib_results["failed_users"]:
                print(
                    f"✗ Failed to create {failed['email']}: {failed['error']}",
                    file=sys.stderr,
                )

        # Transform results back to original format for JSON output
        results: Dict[str, Any] = {
            "entity": lib_results["entity"],
            "admins": [u for u in lib_results["users"] if u.get("role") == "admin"],
            "users": [u for u in lib_results["users"] if u.get("role") == "user"],
        }

        if args.json:
            print(json.dumps(results, indent=2))
        else:
            print("✓ Provisioning complete")

    except Exception as e:
        if args.json:
            print(json.dumps({"success": False, "error": str(e)}, indent=2))
        else:
            print(f"✗ Error: {e}", file=sys.stderr)
        sys.exit(1)


# ============================================================================
# MAIN & ARGPARSE
# ============================================================================


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="workspace-admin",
        description="Admin CLI - Manage entities, users, and provisioning.",
        epilog=f"Version {VERSION} | Sign in for several commands: {LOGIN_HINT}",
        fromfile_prefix_chars="@",
    )
    subparsers = parser.add_subparsers(
        dest="noun", required=True, help="Resource to manage"
    )

    # ==========================
    # Auth
    # ==========================
    auth = subparsers.add_parser("auth", help="Manage authentication session")
    auth_sub = auth.add_subparsers(dest="verb", required=True, help="Action")

    login = auth_sub.add_parser(
        "login",
        help=f"Sign in and print the session as shell exports: {LOGIN_HINT}",
    )
    login.add_argument(
        "--api-url", help=f"Target API URL (default: ${BASE_URL_ENV} or {BASE_URL})"
    )
    login.add_argument("--email", help="Admin account email address")
    login.add_argument(
        "--password", help="Admin password (interactive prompt if omitted)"
    )
    login.add_argument(
        "--json",
        action="store_true",
        help="Print base_url and access_token as JSON instead of shell exports",
    )
    login.set_defaults(func=auth_login)

    auth_sub.add_parser(
        "logout",
        help=f'End the ${TOKEN_ENV} session: eval "$(workspace-admin auth logout)"',
    ).set_defaults(func=auth_logout)

    status_parser = auth_sub.add_parser(
        "status", help=f"Show the API URL and whether ${TOKEN_ENV} is set"
    )
    status_parser.add_argument(
        "--json", action="store_true", help="Output status as JSON object"
    )
    status_parser.set_defaults(func=auth_status)

    # ==========================
    # Entity
    # ==========================
    entity = subparsers.add_parser("entity", help="Manage organization entities")
    entity_sub = entity.add_subparsers(dest="verb", required=True, help="Action")

    e_create = entity_sub.add_parser("create", help="Create a new entity")
    e_create.add_argument(
        "--config",
        "-c",
        required=True,
        help="Path to JSON config file with entity details",
    )
    e_create.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    e_create.set_defaults(func=entity_create)

    e_list = entity_sub.add_parser("list", help="List all entities")
    e_list.add_argument("--page", type=int, default=1, help="Page number (default: 1)")
    e_list.add_argument(
        "--size", type=int, default=100, help="Items per page (default: 100)"
    )
    e_list.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    e_list.set_defaults(func=entity_list)

    e_sample = entity_sub.add_parser(
        "sample", help="Output a valid sample entity creation JSON to stdout"
    )
    e_sample.set_defaults(func=entity_sample)

    e_show = entity_sub.add_parser("show", help="Show details of a specific entity")
    e_show.add_argument("entity_uuid", help="Unique identifier (UUID) of the entity")
    e_show.add_argument(
        "--json", action="store_true", help="Output full entity object as JSON"
    )
    e_show.set_defaults(func=entity_show)

    e_update = entity_sub.add_parser("update", help="Update an existing entity")
    e_update.add_argument("entity_uuid", help="Unique identifier (UUID) of the entity")
    e_grp = e_update.add_mutually_exclusive_group(required=True)
    e_grp.add_argument(
        "--config", "-c", help="Path to JSON file containing fields to update"
    )
    e_grp.add_argument(
        "--data",
        "-d",
        dest="json_input",
        help="JSON string with fields to update (e.g. '{\"sharing_enabled\": true}')",
    )
    e_update.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    e_update.set_defaults(func=entity_update)

    e_delete = entity_sub.add_parser("delete", help="Delete an existing entity")
    e_delete.add_argument("entity_uuid", help="Unique identifier (UUID) of the entity")
    e_delete.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    e_delete.set_defaults(func=entity_remove)

    # ==========================
    # Entity Type
    # ==========================
    et = subparsers.add_parser("entity-type", help="Manage entity definitions")
    et_sub = et.add_subparsers(dest="verb", required=True, help="Action")

    et_create = et_sub.add_parser("create", help="Define a new entity type")
    et_create.add_argument(
        "--name", required=True, help="Display name for the entity type"
    )
    et_create.add_argument("--code", required=True, help="Internal code identifier")
    et_create.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    et_create.set_defaults(func=entity_type_create)

    et_list = et_sub.add_parser("list", help="List available entity types")
    et_list.add_argument("--page", type=int, default=1, help="Page number (default: 1)")
    et_list.add_argument(
        "--size", type=int, default=100, help="Items per page (default: 100)"
    )
    et_list.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    et_list.set_defaults(func=entity_type_list)

    # ==========================
    # User
    # ==========================
    user = subparsers.add_parser("user", help="Manage users within entities")
    user_sub = user.add_subparsers(dest="verb", required=True, help="Action")

    u_create = user_sub.add_parser(
        "create", help="Create and assign a user to an entity"
    )
    u_create.add_argument("entity_uuid", help="UUID of the target entity")
    u_create.add_argument("--email", required=True, help="User's email address")
    u_create.add_argument("--first-name", required=True, help="User's first name")
    u_create.add_argument("--last-name", required=True, help="User's last name")
    u_create.add_argument(
        "--role",
        choices=list(PERMISSION_MAPS),
        default="user",
        help="Role assignment (default: user)",
    )
    u_create.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_create.set_defaults(func=user_create)

    u_list = user_sub.add_parser("list", help="List users (globally or filtered)")
    u_list.add_argument("--page", type=int, default=1, help="Page number (default: 1)")
    u_list.add_argument(
        "--size", type=int, default=100, help="Items per page (default: 100)"
    )
    u_list.add_argument("--email", help="Filter by exact email match")
    u_list.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_list.set_defaults(func=user_list)

    u_export = user_sub.add_parser(
        "export", help="Download a user's data as a portable archive"
    )
    u_export.add_argument("email", help="Email address of the account to export")
    u_export.add_argument(
        "--out",
        default=".",
        help="Directory or file path to write the archive to (default: .)",
    )
    u_export.add_argument(
        "--include-history",
        action="store_true",
        help="Include dashboard version history (much larger archive)",
    )

    u_export.add_argument(
        "--with-files",
        action="store_true",
        help="Download the account's uploaded files into the archive. Slow, and "
        "on a large account may exceed the server's proxy timeout.",
    )
    u_export.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_export.set_defaults(func=user_export)

    u_del = user_sub.add_parser("delete", help="Remove a user from the system")
    u_del.add_argument("email", help="Email address of the user to remove")
    u_del.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_del.set_defaults(func=user_delete)

    u_reset = user_sub.add_parser(
        "reset-password",
        help="Reset a user's password and print the link that sets a new one",
    )
    u_reset.add_argument("email", help="Email address of the user")
    u_reset.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_reset.set_defaults(func=user_reset_password)

    u_move = user_sub.add_parser(
        "move", help="Move a user to another entity without invitation"
    )
    u_move.add_argument(
        "--entity-uuid", required=True, help="UUID of the target entity"
    )
    u_move.add_argument(
        "--email", required=True, help="Email address of the user to move"
    )
    u_move.add_argument(
        "--role",
        choices=list(PERMISSION_MAPS),
        default="user",
        help="Role assignment in new entity (default: user)",
    )
    u_move.add_argument(
        "--json", action="store_true", help="Output raw API response as JSON"
    )
    u_move.set_defaults(func=user_move)

    # ==========================
    # Data Backend
    # ==========================
