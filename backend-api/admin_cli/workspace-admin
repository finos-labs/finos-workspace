def print_import_instructions(
    archive: Path, email: str, with_files: bool = False
) -> None:
    """Print the steps to hand to the person receiving the archive.

    The same instructions ship inside the archive as README.md, but the operator
    passing the file on should not have to unzip it to find them.
    """
    name = archive.name
    print("-" * 72)
    print(f"  SEND THIS TO {email}")
    print("-" * 72)
    print(f"""
  Your Workspace data is in {name}.

  To load it into Lite:

    1. Start Lite with the folder holding this file mounted:

       docker run -d --name workspace -p 3000:3000 \\
           -v workspace-data:/data \\
           -v /path/to/the/folder:/import \\
           lite

    2. Import it. It asks for the export key, which reaches you separately:

       docker exec -it workspace workspace-import /import/{name}

    3. Get the admin login and sign in at http://localhost:3000

       docker exec workspace credentials

    4. As the admin, set a password for {email}.
       Your old Workspace password does not carry over -- it was never exported.

  Notes:""")
    if with_files:
        print(
            "    - Your uploaded files are in the archive's files/ folder. They are\n"
            "      NOT loaded into Lite, so unzip and keep them somewhere safe."
        )
    else:
        print(
            "    - This archive does not include your uploaded files, only the\n"
            "      record of them. Ask for an export with files if you need them."
        )
    print(
        "    - The credentials in the archive are encrypted with the export key.\n"
        "      The rest is not: keep it private and delete it once imported."
    )
    print()
    print("-" * 72)


def user_export(args: argparse.Namespace) -> None:
    client = get_client()
    try:
        # Compose primitives: lookup user + download their archive
        user = client.user_get_by_email(args.email)
        payload, suggested, export_key = client.user_export(
            user["uuid"],
            include_history=args.include_history,
            with_files=args.with_files,
        )
    except APIError as e:
        handle_api_error(e)
        return

    out = Path(args.out)
    if out.is_dir() or not out.suffix:
        out.mkdir(parents=True, exist_ok=True)
        out = out / (suggested or f"workspace-export-{user['uuid']}.zip")
    else:
        out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(payload)

    if args.json:
        print(
            json.dumps(
                {"path": str(out), "bytes": len(payload), "export_key": export_key},
                indent=2,
            )
        )
        return

    print(f"✓ Exported {args.email} to {out} ({len(payload) / 1024:.0f} KB)")
    print()
    print(f"  Export key (shown once, stored nowhere): {export_key}")
    print("  The archive's credentials are sealed with it. Send it to the person")
    print("  importing the archive separately from the file.")
    print()
    print_import_instructions(out, args.email, with_files=args.with_files)


