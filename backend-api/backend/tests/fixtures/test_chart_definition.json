{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "maxLength": 80 },
    "series": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/series" }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "maxLength": 64 },
        "kind": { "enum": ["line", "bar"] }
      }
    }
  }
}
