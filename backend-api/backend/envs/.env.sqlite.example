# Minimal SQLite configuration.
# The secrets are blank: write them, and the administrator's seed config, with
#   python -m scripts.create_local_env --sqlite --admin-email <your-email>
DATABASE_TYPE=sqlite
DB_PATH=test_sqlite.db

# Redis (still required by Settings class)
REDIS_HOST=localhost
REDIS_PASS=

# Minimal app config
MODE=lite
JWT_SECRET=
WORKSPACE_AUTH_TOKEN=
WORKSPACE_AES_KEY=
FRONTENDURL=http://localhost
SELFURL=http://localhost:8000
APPURL=http://localhost:1420
WORKSPACE_FRONTEND_USER_AGENT=test
PROMETHEUS=0
STORAGE_PROVIDER=folder
FOLDER_STORAGE_PATH=/opt/code/local_storage
LOCAL_STORAGE_SECRET_KEY=
WORKERS=1
# Disable new user registration. When set to 1, every path that creates a user
# returns 403 "Registration is disabled": POST /admin/register,
# POST /entity/register-admin, sharing with someone who has no account, and the
# first SSO sign-in of a new user. Existing users can still log in and use the
# app as normal. Set this for deployments where accounts are provisioned out of band.
# Read once at startup - restart the app (or the pod) after you change it.
DISABLE_REGISTRATION=0
DISABLE_CORS=1
SUPPRESSED_API_ROUTERS=["run_tasks"]
SUPPRESSED_API_ROUTES=[]
