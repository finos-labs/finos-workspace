# Workspace Backend Configuration
# ⚠️ MIGHT CONTAIN SENSITIVE INFORMATION - DO NOT SHARE ⚠️

### DATABASE CONFIG ###
# Database type (mysql/postgresql/sqlite)
DATABASE_TYPE=mysql

# --- MySQL/PostgreSQL settings ---
# Database host
DB_HOST=mysql # For local debug (i.e., docker-compose-local-dev.yml), you need to set the DB_HOST to "localhost"
# Database port
DB_PORT=3306
# Database name
DB_NAME=sample_db
# Database read user
READ_DB_USER=root
# Database read password
READ_DB_PASSWORD=root
# Database write user
WRITE_DB_USER=root
# Database write password
WRITE_DB_PASSWORD=root
# SSL Certificate Authority file path (optional)
# SSL_CA=/path/to/ca.pem
# SSL Client Certificate file path (optional)
# SSL_CERT=/path/to/client-cert.pem
# SSL Client Key file path (optional)
# SSL_KEY=/path/to/client-key.pem

# --- SQLite settings (used when DATABASE_TYPE=sqlite) ---
# File path for the SQLite database
# DB_PATH=/data/workspace.db
### DATABASE CONFIG END ###

### REDIS CONFIG ###
# Redis host
REDIS_HOST=redis # localhost # For local debug (i.e., docker-compose-local-dev.yml), you need to set the REDIS_HOST to "localhost"
# Redis username (Optional - leave empty if not used)
REDIS_USER=
# Redis password
REDIS_PASS=
# Redis port
REDIS_PORT=6379
# Redis Cluster Mode (set to 1 for cluster mode, 0 for single-node)
REDIS_CLUSTER_MODE=0
# Set REDIS_RQ_HASH_TAGS to work with sharded redis that does not expose cluster endpoints
REDIS_RQ_HASH_TAGS=0
### REDIS CONFIG END ###

### ADMIN NOTIFICATIONS ###
# Transport for admin notifications (new entities), as an
# import path `package.module:Class`. The default POSTs JSON to ADMIN_NOTIFY_WEBHOOK_URL.
# ADMIN_NOTIFIER=api.notifications:WebhookNotifier
# Webhook URL; leave unset to log notifications instead of sending them
# ADMIN_NOTIFY_WEBHOOK_URL=https://hooks.example.com/workspace-admin
# Secret for the X-Admin-Notification-Signature HMAC-SHA256 header (optional)
# ADMIN_NOTIFY_WEBHOOK_SECRET=pat-webhook-secret
# Recipient and sender passed to the transport in the notification payload
# ADMIN_NOTIFY_RECIPIENT=reviewers@example.com
# ADMIN_NOTIFY_SENDER=workspace@example.com
### ADMIN NOTIFICATIONS END ###

### PROMETHEUS CONFIG ###
# Prometheus enabled/disabled
PROMETHEUS=1
### PROMETHEUS CONFIG END ###

### STORAGE CONFIG ###
# Storage provider (folder/aws/azure/gcp); defaults to folder
STORAGE_PROVIDER=aws
# Local folder storage (used when STORAGE_PROVIDER=folder)
# FOLDER_STORAGE_PATH=local_storage
# Signs the pre-signed file URLs; required with STORAGE_PROVIDER=folder, at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# LOCAL_STORAGE_SECRET_KEY=

# --- S3 (used when STORAGE_PROVIDER=aws) ---
# S3 access key
S3_ACCESS_KEY=pat-s3-access-key
# S3 secret key
S3_SECRET_KEY=pat-s3-secret-key
# S3 bucket name
S3_BUCKET_NAME=pat-s3-bucket-name
# S3 bucket for uploaded files (also read from S3_BUCKET)
S3_FILE_BUCKET=pat-s3-file-bucket
# S3 region (optional - e.g., us-east-1, ca-central-1)
S3_REGION=
# S3 endpoint URL
S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3 verify SSL (optional - set to 1 to force SSL verification)
S3_VERIFY_SSL=0
# S3 signature version (s3v4 or v4; optional - defaults to s3v4)
S3_SIGNATURE_VERSION=s3v4

# --- Azure Blob Storage (used when STORAGE_PROVIDER=azure) ---
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_CONTAINER=your-container
# AZURE_CONNECTION_STRING=your-storage-key

# --- Google Cloud Storage (used when STORAGE_PROVIDER=gcp) ---
# GCP_STORAGE_BUCKET=your-bucket
### STORAGE CONFIG END ###

### API CONFIG ###
# API mode
MODE=test
# Suppressed API routers
SUPPRESSED_API_ROUTERS=[]
# Suppressed API routes
SUPPRESSED_API_ROUTES=[]
# Disable new user registration. When set to 1, every path that creates a user
# returns 403 "Registration is disabled": POST /admin/register,
# POST /entity/register-admin, sharing with someone who has no account, and the
# first SSO sign-in of a new user. Existing users can still log in and use the
# app as normal. Set this for deployments where accounts are provisioned out of band.
# Read once at startup - restart the app (or the pod) after you change it.
DISABLE_REGISTRATION=0
# The origins of the web app, exactly as browsers send them (scheme, host and port; no
# path, no *). Required. Its session cookie is accepted only from these. The local ones:
# docker-compose.yml's web app (3000) and the dev server of local/compose.yaml (1420). Sessions are cookies, which
# browsers send to the API only when it is on the same site as the page: serve it under the
# web app's registrable domain (or under /api of the web app's own origin),
# and over HTTPS outside localhost.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:1420"]
# Addresses exempt from the duplicate-email checks on account creation
# SPECIAL_EMAILS=[]
# Number of workers
WORKERS=1
# Port to run on default is 8000
#PORT=8000

# MCP servers on a private network, by host name, exactly as their URLs name them. The API
# reaches users' MCP servers (its MCP proxy, MCP sign-in) only at public internet addresses;
# a server whose name resolves to a private, loopback or link-local address, such as an
# internal host or a compose service, must be listed here. The servers of DEFAULT_MCP_SERVERS
# need not be: the API reaches their host and port as they are. A JSON list:
# ALLOWED_MCP_HOSTNAMES=["mcp.internal.<your-domain>"]
### API CONFIG END ###

### Workspace configuration ###
# The secrets are blank: `python -m scripts.create_local_env` writes envs/.env with random
# values. To set one yourself, generate it with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT secret - signs the service tokens; at least 32 bytes, the API does not start without it
JWT_SECRET=
# Workspace auth token - a JWT (HS256) signed with JWT_SECRET, used for authentication
WORKSPACE_AUTH_TOKEN=
# Frontend URL
FRONTENDURL=http://127.0.0.1
# Self URL - used to generate URLs for files, check rate limits, etc.
SELFURL=http://127.0.0.1:8000
# App URL - the Workspace frontend, used for login redirects and the password links an
# administrator gives users
APPURL=http://localhost:1420
# Usage metering - the service that serves the Copilot reports usage with a token created by
# `python -m scripts.create_metering_token` in the X-Metering-Authorization header
# Requests with a valid X-Workspace-Authorization token skip rate limiting (development only)
# RATE_LIMIT_EXEMPT_ENABLED=0
# Key of the encryption at rest (AES-256-GCM): stored provider keys, connection and MCP
# headers, authenticator secrets. A base64url string of at least 32 bytes; the API does not
# start without it. Keep it: what is stored under it cannot be read with another key.
WORKSPACE_AES_KEY=
# Sign-in providers: the public ids of this deployment's OAuth clients, the same values the
# web app is configured with. The API accepts a provider's token only when it was issued to
# that client; a provider left blank refuses every sign-in.
# GOOGLE_OAUTH_CLIENT_ID=<your Google OAuth client id>
# AZURE_CLIENT_ID=<your Microsoft Entra application id>
# The tenant whose users may sign in: its id or domain, or "organizations" (every work or
# school tenant) or "common" (those and personal Microsoft accounts), as in the web app's
# MSAL authority
# AZURE_TENANT_ID=<your Microsoft Entra tenant id>
# The Entra app registration must send the optional ID-token claims `email` and `xms_edov`
# (Token configuration > Add optional claim > ID). Without them Microsoft vouches for no
# address, and a Microsoft sign-in by email is refused: it neither creates an account nor
# reaches an existing one or an invitation. An account already linked to that Microsoft
# user still signs in.
# OKTA_CLIENT_ID=<your Okta client id>
# The Okta issuer, exactly the web app's VITE_OKTA_DOMAIN (e.g. https://<your-org>.okta.com
# or https://<your-org>.okta.com/oauth2/default)
# OKTA_DOMAIN=<your Okta issuer>
### Workspace configuration END ###
