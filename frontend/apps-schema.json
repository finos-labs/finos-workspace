{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "$ref": "#/definitions/AppsJson"
  },
  "definitions": {
    "AppsJson": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^custom-.+"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "selected_agent": {
          "type": "string"
        },
        "img": {
          "type": "string"
        },
        "img_dark": {
          "type": "string"
        },
        "img_light": {
          "type": "string"
        },
        "authentication": {
          "type": "string"
        },
        "tabs": {
          "$ref": "#/definitions/Tabs"
        },
        "groups": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Group"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "authType": {
                "type": "string",
                "enum": [
                  "oauth",
                  "token"
                ]
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "allowCustomization": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "tabs"
      ],
      "additionalProperties": false
    },
    "Tabs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "layout": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Layout"
            }
          }
        },
        "required": [
          "id",
          "name",
          "layout"
        ],
        "additionalProperties": false
      }
    },
    "Layout": {
      "type": "object",
      "properties": {
        "i": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "minW": {
          "type": "number"
        },
        "minH": {
          "type": "number"
        },
        "maxW": {
          "type": "number"
        },
        "maxH": {
          "type": "number"
        },
        "moved": {
          "type": "boolean"
        },
        "static": {
          "type": "boolean"
        },
        "isDraggable": {
          "type": "boolean"
        },
        "state": {
          "allOf": [
            {
              "$ref": "#/definitions/WidgetState"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "i",
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": {}
    },
    "WidgetState": {
      "type": "object",
      "properties": {
        "paramOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "storage": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "html": {
              "type": "string"
            },
            "plugin": {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "Group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "paramName": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "widgetIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultValue": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    }
  }
}