# Configuration of the Workspace web app. Everything in this file ends up in the browser:
# never put a secret here.
#
# `bun run dev` reads these variables. `bun run build:runtime` writes them to dist/config.js,
# which an operator can edit or replace at deploy time without rebuilding. The schema in
# src/lib/runtimeConfigSchema.ts names every setting and holds its default; a variable that is
# left out or empty takes the default.

# Version shown in the sidebar and in the changelog
VITE_RELEASE_VERSION="v1.0.0"

# Highlight components that re-render, for performance work (https://github.com/aidenybai/react-scan)
VITE_ENABLE_RENDER_SCANNING="false"

# --- Services ---
# The Workspace backend
VITE_BACKEND_URL="http://localhost:8000"
# The AI service the Copilot talks to
VITE_AI_API_URL=""

# --- Links and contact ---
# Where the documentation lives. Empty: the links to it are hidden.
VITE_DOCS_URL=""
# Where users are sent for help. Empty: no address is shown.
VITE_SUPPORT_EMAIL=""

# --- Authentication ---
# Sign in with an email address and a password
VITE_AUTHENTICATION_ALLOW_EMAIL_LOGIN="true"
# Single sign-on providers to offer, comma separated: google, microsoft, okta. Empty: none.
VITE_AUTHENTICATION_IDENTITY_PROVIDERS=""
VITE_GOOGLE_OAUTH_CLIENT_ID=""
VITE_AZURE_CLIENT_ID=""
VITE_AZURE_TENANT_ID=""
VITE_OKTA_CLIENT_ID=""
# The Okta issuer URL, for example https://<your-okta-domain>/oauth2/default
VITE_OKTA_DOMAIN=""
# Pass the identity token of the provider on to the backend
VITE_AUTHENTICATION_SEND_MICROSOFT_IDTOKEN="false"
VITE_AUTHENTICATION_SEND_OKTA_IDTOKEN="false"
# Send the signed-in user's email address as a header with every request
VITE_AUTHENTICATION_SEND_USER_EMAIL_AS_HEADER="false"

# --- Copilot ---
# Master switch: off hides the Copilot panel and everything that feeds it
VITE_AI_COPILOT_ENABLED="true"
VITE_AI_COPILOT_DEFAULT_COPILOT="true"
VITE_AI_COPILOT_DOCUMENTATION_LINKS="true"
VITE_AI_COPILOT_WEB_SEARCH="true"
VITE_AI_COPILOT_SEC_FILINGS="false"
VITE_AI_COPILOT_JINA_AI="true"
VITE_AI_COPILOT_AI_ENHANCEMENTS="true"
VITE_AI_COPILOT_SAVE_SKILL_FROM_CHAT="true"
# Let users add their own model API key
VITE_AI_SHOW_CUSTOM_COPILOT_KEY="true"

# --- Interface ---
VITE_UI_SHOW_COMPANION_MCP_MODE="false"
VITE_UI_SHOW_MINIMIZE_WIDGET="true"
VITE_UI_SHOW_EXTERNAL_DOCUMENTATION_LINKS="true"
VITE_UI_SHOW_HELP_DOCUMENTATION="true"
VITE_UI_SHOW_CHANGELOG="true"
VITE_UI_SHOW_COPILOT_SWITCHER="true"
VITE_UI_SHOW_REMOVE_FROM_ORG="true"
# "light" or "dark"
VITE_UI_DEFAULT_THEME="dark"
# Let HTML widgets run JavaScript
VITE_ALLOW_HTML_JS_EXECUTION="false"

# --- White label ---
# Name in the browser tab, the manifest and the sign-in page
VITE_WL_NAME="Workspace"
VITE_WL_SHORT_NAME="Workspace"
# Image on the sign-in page (at most 130px high), for the light and the dark theme
VITE_WL_LOGIN_IMAGE="/assets/images/logo-horizontal-color.svg"
VITE_WL_LOGIN_IMAGE_DARK="/assets/images/logo-horizontal-white.svg"
# Square logo at the top of the sidebar, for the light and the dark theme. Empty: the built-in logo.
VITE_WL_LEFT_SIDEBAR_LOGO=""
VITE_WL_LEFT_SIDEBAR_LOGO_DARK=""
VITE_WL_FAVICON="/logo.svg"
# Page description and keywords for search engines
VITE_WL_DESCRIPTION="An open, self-hosted analytics workspace for financial institutions to connect data, tools, and AI agents."
VITE_WL_KEYWORDS="FINOS Workspace, open source financial analytics, self-hosted analytics, financial data workspace, AI agents"
# Main colour of the app, as a hex colour
VITE_WL_MAIN_COLOR="#0086BF"
# Montserrat (FINOS web font), Inter, or Roboto
VITE_WL_FONT_FAMILY="Montserrat"
# Show the floating panel for trying out colours and fonts
VITE_WL_SHOW_FLOATING_THEME_PREVIEW="false"
